import React, { useState, useEffect } from 'react';
import { motion } from 'framer-motion';
import emailjs from '@emailjs/browser';
import Header from '../Home/Components/Header';
import Footer from '../../Components/Footer';
import ExclusiveOffer from '../Home/Components/ExclusiveOffer';
import BookingPrompt from '../Home/Components/BookingPrompt';
import { FaInstagram, FaTiktok, FaWhatsapp } from 'react-icons/fa';

// Packages array (your original)
export const packages = [
  // ... your full packages array
];

const Contact = () => {
  const [formMode, setFormMode] = useState('inquiry');
  const [formData, setFormData] = useState({ name: '', email: '', subject: '', message: '', attachment: null, phone: '', notes: '' });
  const [selectedPackage, setSelectedPackage] = useState({ title: 'Select a Package', price: '' });
  const [validationErrors, setValidationErrors] = useState({});
  const [errorMessage, setErrorMessage] = useState('');
  const [showPopup, setShowPopup] = useState(false);
  const [showConfirm, setShowConfirm] = useState(false);
  const [showTermsPopup, setShowTermsPopup] = useState(false);
  const [showNoteLimitAlert, setShowNoteLimitAlert] = useState(false);
  const [isSubmitted, setIsSubmitted] = useState(false);
  const [submittedData, setSubmittedData] = useState({});
  const [acceptedTerms, setAcceptedTerms] = useState(false);
  const [isVisible, setIsVisible] = useState(false);

  useEffect(() => {
    // Initialize EmailJS with the appropriate Public Key based on form mode
    const initializeEmailJS = () => {
      if (formMode === 'inquiry') {
        emailjs.init('INQUIRY_PUBLIC_KEY'); // Replace with Account 1 Public Key
      } else {
        emailjs.init('BOOKING_PUBLIC_KEY'); // Replace with Account 2 Public Key
      }
    };
    initializeEmailJS();

    const handleScroll = () => {
      setIsVisible(window.scrollY > 300);
    };
    const handleKeyPress = (e) => {
      if (e.key === 'Escape') {
        setShowPopup(false);
        setShowConfirm(false);
        setShowTermsPopup(false);
        setShowNoteLimitAlert(false);
        setIsSubmitted(false);
      }
    };
    window.addEventListener('scroll', handleScroll);
    window.addEventListener('keydown', handleKeyPress);
    return () => {
      window.removeEventListener('scroll', handleScroll);
      window.removeEventListener('keydown', handleKeyPress);
    };
  }, [formMode]);

  const validateEmail = (email) => {
    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    return emailRegex.test(email);
  };

  const validatePhone = (phone) => {
    const phoneRegex = /^\+?[\d\s-]{10,}$/;
    return phoneRegex.test(phone);
  };

  const handleChange = (e) => {
    // ... (your original handleChange logic)
  };

  const handleSubmit = async (e) => {
    e.preventDefault();
    if (formMode === 'inquiry') {
      const errors = {
        name: !formData.name.trim(),
        email: !formData.email || !validateEmail(formData.email),
        phone: !formData.phone || !validatePhone(formData.phone),
        subject: !formData.subject.trim(),
        message: !formData.message.trim(),
      };
      setValidationErrors(errors);
      if (Object.values(errors).some(error => error)) {
        setErrorMessage('Please fill in all required fields with valid information.');
        return;
      }
      if (formData.notes && formData.notes.length > 250) {
        setShowNoteLimitAlert(true);
        return;
      }

      let attachmentUrl = '';
      if (formData.attachment) {
        const formDataToUpload = new FormData();
        formDataToUpload.append('file', formData.attachment);
        formDataToUpload.append('upload_preset', 'YOUR_CLOUDINARY_UPLOAD_PRESET'); // Replace with your preset

        try {
          const response = await fetch('https://api.cloudinary.com/v1_1/YOUR_CLOUDINARY_CLOUD_NAME/upload', { // Replace with your cloud name
            method: 'POST',
            body: formDataToUpload,
          });
          const data = await response.json();
          attachmentUrl = data.secure_url;
        } catch (error) {
          setErrorMessage('Failed to upload attachment.');
          return;
        }
      }

      const templateParams = {
        to_name: formData.name,
        from_name: formData.name,
        from_email: formData.email,
        subject: formData.subject,
        message: formData.message,
        phone: formData.phone,
        notes: formData.notes || 'None',
        attachment_url: attachmentUrl || 'None',
      };

      try {
        await emailjs.send('INQUIRY_SERVICE_ID', 'template_inquiry_combined', templateParams); // Replace IDs
        setSubmittedData({ ...formData, attachment_url: attachmentUrl });
        setIsSubmitted(true);
        setShowPopup(true);
        setFormData({ name: '', email: '', subject: '', message: '', attachment: null, phone: '', notes: '' });
      } catch (error) {
        console.error('Inquiry Error:', error);
        setErrorMessage('Failed to submit inquiry. Error: ' + error.message);
      }
    } else {
      const errors = {
        name: !formData.name.trim(),
        email: !formData.email || !validateEmail(formData.email),
        phone: !formData.phone || !validatePhone(formData.phone),
        package: !selectedPackage || selectedPackage.title === 'Select a Package'
      };
      setValidationErrors(errors);
      if (Object.values(errors).some(error => error)) {
        setErrorMessage('Please fill in all required fields with valid information.');
        return;
      }
      if (!acceptedTerms) {
        setShowTermsPopup(true);
        return;
      }
      setShowConfirm(true);
    }
  };

  const handleConfirmSubmit = async () => {
    const templateParams = {
      to_name: formData.name,
      from_name: formData.name,
      from_email: formData.email,
      phone: formData.phone,
      notes: formData.notes || 'None',
      package_title: selectedPackage.title,
      package_price: selectedPackage.price,
    };

    try {
      await emailjs.send('BOOKING_SERVICE_ID', 'template_booking_combined', templateParams); // Replace IDs
      setSubmittedData({ ...formData, package: selectedPackage });
      setShowConfirm(false);
      setIsSubmitted(true);
      setShowPopup(true);
      setFormData({ name: '', email: '', subject: '', message: '', attachment: null, phone: '', notes: '' });
      setSelectedPackage({ title: 'Select a Package', price: '' });
      setAcceptedTerms(false);
    } catch (error) {
      console.error('Booking Error:', error);
      setErrorMessage('Failed to confirm booking. Error: ' + error.message);
    }
  };

  // ... (rest of your original code: handleTermsAccept, handleClosePopup, etc.)
  // ... (render logic with JSX)

  return (
    // ... (your original JSX)
  );
};

export default Contact;